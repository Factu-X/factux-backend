# Copy this file to `.env` and replace placeholders with your real values.
# Do not commit `.env`.

PORT=4000

# PostgreSQL connection string from Supabase.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth public project settings. Do not use the service role key here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Solo backend. Necesaria para crear usuarios desde POST /api/usuarios.
# Nunca la expongas en el frontend ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Origenes permitidos para CORS, separados por coma. Por defecto http://localhost:5173.
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_PER_MINUTE=300

# HU-11 (opcional): envio de recordatorios por correo con Resend. Sin estas dos variables el envio responde 503.
# EMAIL_FROM debe ser un remitente de un dominio verificado en Resend, p. ej. "Taller <avisos@tudominio.co>".
RESEND_API_KEY=""
EMAIL_FROM=""
