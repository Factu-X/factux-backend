# Copy this file to `.env` and replace placeholders with your real values.
# Do not commit `.env`.

PORT=4000

# PostgreSQL connection string from Supabase.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth public project settings. Do not use the service role key here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Solo backend. Necesaria para crear usuarios desde POST /api/usuarios.
# Nunca la expongas en el frontend ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Origenes permitidos para CORS, separados por coma. Vacio = cualquiera (solo desarrollo).
CORS_ORIGINS="http://localhost:5173"
RATE_LIMIT_PER_MINUTE=300

# Software propio ante la DIAN (ambiente de habilitacion). Solo backend.
# El certificado (.p12) va fuera del repositorio.
DIAN_SOFTWARE_ID=""
DIAN_SOFTWARE_PIN=""
DIAN_CLAVE_TECNICA=""
DIAN_CERT_PATH=""
DIAN_CERT_PASSWORD=""
