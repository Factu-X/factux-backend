# Copy this file to `.env` and replace placeholders with your real values.
# Do not commit `.env`.

PORT=4000

# PostgreSQL connection string from Supabase.
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Supabase Auth public project settings. Do not use the service role key here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Solo backend. Necesaria para crear usuarios desde POST /api/usuarios.
# Nunca la expongas en el frontend ni la subas al repositorio.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
