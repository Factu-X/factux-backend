  model RecordatoriosMantenimiento {
    id                    Uuid                        @id(map: "recordatorios_mantenimiento_pkey") @default(dbgenerated("gen_random_uuid()"))
    motocicletaId         Uuid                        @map("motocicleta_id")
    ordenOrigenId         Uuid?                       @map("orden_origen_id")
    creadoPor             Uuid?                       @map("creado_por")
    tipoMantenimiento     VarChar(200)                @map("tipo_mantenimiento")
    descripcion           String?
    fechaObjetivo         Date?                       @map("fecha_objetivo")
    kilometrajeObjetivo   Int?                        @map("kilometraje_objetivo")
    estado                pg.enum(EstadoRecordatorio) @default("PENDIENTE")
    notificacionEnviadaAt Timestamptz?                @map("notificacion_enviada_at")
    completadoAt          Timestamptz?                @map("completado_at")
    createdAt             Timestamptz                 @default(now()) @map("created_at")
    updatedAt             Timestamptz                 @default(now()) @map("updated_at")
    profiles              Profiles?                   @relation(fields: [creadoPor], references: [id], onDelete: SetNull, map: "recordatorios_mantenimiento_creado_por_fkey", index: false)
    motocicleta           Motocicletas                @relation(fields: [motocicletaId], references: [id], onDelete: Restrict, map: "recordatorios_mantenimiento_motocicleta_id_fkey")
    ordenOrigen           OrdenesServicio?            @relation(fields: [ordenOrigenId], references: [id], onDelete: SetNull, map: "recordatorios_mantenimiento_orden_origen_id_fkey", index: false)

    @@index([estado], map: "idx_recordatorios_estado")
    @@index([fechaObjetivo], map: "idx_recordatorios_fecha")
    @@index([motocicletaId], map: "idx_recordatorios_motocicleta")
    @@check(expression: "((kilometraje_objetivo IS NULL) OR (kilometraje_objetivo >= 0))", map: "chk_recordatorio_km")
    @@check(expression: "((fecha_objetivo IS NOT NULL) OR (kilometraje_objetivo IS NOT NULL))", map: "chk_recordatorio_objetivo")
    @@rls
    @@map("recordatorios_mantenimiento")
  }

  model UsabilidadSesiones {
    id            Uuid                  @id(map: "usabilidad_sesiones_pkey") @default(dbgenerated("gen_random_uuid()"))
    participante  VarChar(150)
    perfil        VarChar(200)?
    fechaSesion   Date                  @default(dbgenerated("CURRENT_DATE")) @map("fecha_sesion")
    observaciones String?
    susRespuestas String                @map("sus_respuestas")
    susPuntaje    Numeric(5, 2)         @map("sus_puntaje")
    creadaPor     Uuid?                 @map("creada_por")
    createdAt     Timestamptz           @default(now()) @map("created_at")
    updatedAt     Timestamptz           @default(now()) @map("updated_at")
    tareas        UsabilidadTareas[]
    hallazgos     UsabilidadHallazgos[]
    profiles      Profiles?             @relation(fields: [creadaPor], references: [id], onDelete: SetNull, map: "usabilidad_sesiones_creada_por_fkey", index: false)

    @@index([fechaSesion], map: "idx_usabilidad_sesiones_fecha")
    @@check(expression: "((sus_puntaje >= (0)::numeric) AND (sus_puntaje <= (100)::numeric))", map: "chk_usabilidad_sus_puntaje")
    @@rls
    @@map("usabilidad_sesiones")
  }

  model UsabilidadTareas {
    id            Uuid               @id(map: "usabilidad_tareas_pkey") @default(dbgenerated("gen_random_uuid()"))
    sesionId      Uuid               @map("sesion_id")
    tarea         VarChar(250)
    completada    Boolean            @default(false)
    errores       Int                @default(0)
    observaciones String?
    createdAt     Timestamptz        @default(now()) @map("created_at")
    sesion        UsabilidadSesiones @relation(fields: [sesionId], references: [id], onDelete: Cascade, map: "usabilidad_tareas_sesion_id_fkey")

    @@index([sesionId], map: "idx_usabilidad_tareas_sesion")
    @@check(expression: "(errores >= 0)", map: "chk_usabilidad_tarea_errores")
    @@rls
    @@map("usabilidad_tareas")
  }

  model UsabilidadHallazgos {
    id          Uuid               @id(map: "usabilidad_hallazgos_pkey") @default(dbgenerated("gen_random_uuid()"))
    sesionId    Uuid               @map("sesion_id")
    descripcion String
    pantalla    VarChar(100)?
    prioridad   VarChar(10)
    enBacklog   Boolean            @default(false) @map("en_backlog")
    resuelto    Boolean            @default(false)
    createdAt   Timestamptz        @default(now()) @map("created_at")
    updatedAt   Timestamptz        @default(now()) @map("updated_at")
    sesion      UsabilidadSesiones @relation(fields: [sesionId], references: [id], onDelete: Cascade, map: "usabilidad_hallazgos_sesion_id_fkey")

    @@index([sesionId], map: "idx_usabilidad_hallazgos_sesion")
    @@check(expression: "((prioridad)::text = ANY ((ARRAY['CRITICA'::character varying, 'ALTA'::character varying, 'MEDIA'::character varying, 'BAJA'::character varying])::text[]))", map: "chk_usabilidad_hallazgo_prioridad")
    @@rls
    @@map("usabilidad_hallazgos")
  }

